{
  "name": "coherence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/preflight.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "preflight": "node scripts/preflight.mjs",
    "precheck": "node scripts/preflight.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:routes && npm run check:css",
    "check:routes": "node scripts/check-route-auth.mjs",
    "check:css": "node scripts/check-css-prefixes.mjs",
    "land": "node scripts/land.mjs",
    "worktrees": "node scripts/worktrees.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/react": "^4.0.102",
    "@clerk/nextjs": "^7.9.2",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.99",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
