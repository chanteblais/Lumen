 "inventory": [
  {
   "id": "table",
   "layer": true,
   "why": "the low table with its books, lantern, plant, small stack and mug stands in the middle of the rug; she walks all round it, and close behind it is where the hand-traced map failed"
  },
  {
   "id": "cushion-cream",
   "layer": true,
   "why": "the tasselled floor cushion in front of the table: she passes behind it (between it and the table's left leg is too tight, but along its left and right) and in front of it"
  },
  {
   "id": "cushion-green",
   "layer": true,
   "why": "the quilted green floor cushion in front of the table, the same"
  },
  {
   "id": "armchair",
   "layer": true,
   "why": "the green armchair with its star pillow and two throws: against the bookcase, so she is only ever in front of it or beside it, but it is where she sits (armchair.sit), and the chair's front edge is the floor's edge there"
  },
  {
   "id": "stool",
   "layer": true,
   "why": "the round side stool with its books and a small plant, beside the armchair; she stands beside it and in front of it, and it carries a place anchor"
  },
  {
   "id": "desk",
   "layer": true,
   "why": "the writing desk under the window, with its cabinet, lamp, books, open book, mug and the potted plant on its left end: against the wall, so only in front of or beside her, but it is where she writes and reads"
  },
  {
   "id": "chair",
   "layer": true,
   "why": "the desk chair with the throw over its back, standing out from the desk: she can stand beside it with its back overlapping her"
  },
  {
   "id": "balustrade",
   "layer": true,
   "why": "the railing and posts round the stair going down at the front, with the ivy on its first post: she is only ever behind it, and its posts and rail cross her feet when she stands at the floor's front edge"
  },
  {
   "id": "stair-up",
   "layer": false,
   "why": "the stair up through the arch on the right: built into the wall and the arch; she can only stand in front of it, and cutting it would mean inventing the wall under it. Stays in the plate; its bottom step is a blocker for the floor"
  },
  {
   "id": "bookcase-right",
   "layer": false,
   "why": "the low bookcase with the record player, its plants, pots and candle stack along the right wall: against the wall, she can only be in front of it, and cutting it would mean repainting the wall. Stays in the plate; its front is the floor's edge"
  },
  {
   "id": "log-basket",
   "layer": false,
   "why": "the log basket and the poker bucket beside the stove: on the hearth corner against the walls, behind anywhere she can stand. Stays in the plate"
  },
  {
