# Copy to .env.local.
# Auth (from https://dashboard.clerk.com → API keys; `clerk init` writes these):
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Database — Supabase transaction pooler (port 6543). Dashboard → Connect → Transaction pooler.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Lumi's model (src/core/ai/model.ts): OPENAI_API_KEY
# Optional, to run the Anthropic implementation instead: LUMI_MODEL=anthropic:claude-opus-5 and ANTHROPIC_API_KEY

