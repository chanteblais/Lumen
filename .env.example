# Copy to .env.local and fill in the values.
# Uncommented keys are required: the preflight (scripts/preflight.mjs, before `npm run dev` and `npm run check`)
# names any that .env.local lacks. Commented keys are optional. Nothing loads this file.

# Auth (from https://dashboard.clerk.com → API keys; `clerk init` writes these)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database — Supabase transaction pooler (port 6543). Dashboard → Connect → Transaction pooler.
# Shape: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Lumi's model (src/core/ai/model.ts). The preflight asks for ANTHROPIC_API_KEY instead when LUMI_MODEL names Anthropic.
OPENAI_API_KEY=

# Optional, to run the Anthropic implementation instead:
# LUMI_MODEL=anthropic:claude-opus-5
# ANTHROPIC_API_KEY=

# Optional, local only: every request is one fixed test user, no sign-in (src/lib/dev-user.ts). Works only under
# `npm run dev`; a production server refuses to start with it set. Its rows are real rows in DATABASE_URL's database.
# COHERENCE_DEV_USER=1

# Optional: the people designing Coherence, whose conversations give Lumi her design notebook and a daily design
# digest (src/core/domain/design-contributions.ts). Comma-separated users.id or Clerk user ids; unset, nobody's do.
# COHERENCE_DESIGN_PARTNERS=
