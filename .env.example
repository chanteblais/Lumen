# Copy to .env.local.
# Auth (from https://dashboard.clerk.com → API keys; `clerk init` writes these):
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
# Database — Supabase transaction pooler (port 6543). Dashboard → Connect → Transaction pooler.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# M2: ANTHROPIC_API_KEY
